function rebuildMovies() {

    const movieMap =
        new Map();


    movies.forEach(
        movie => {

            const title =
                String(
                    movie.title || ""
                ).trim();

            const requester =
                String(
                    movie.requester || ""
                ).trim();

            if (!title) {
                return;
            }


            const key =
                title.toLowerCase();


            if (!movieMap.has(key)) {

                movieMap.set(
                    key,
                    {

                        title:
                            title,

                        requesters:
                            requester
                                ? [requester]
                                : [],

                        count:
                            movie.type ===
                            "points"
                                ? 1
                                : 0,

                        type:
                            movie.type ||
                            "points",

                        amount:
                            movie.type ===
                            "donation"
                                ? Number(
                                    movie.amount
                                ) || 0
                                : 0

                    }
                );

            }

            else {

                const existing =
                    movieMap.get(key);


                if (requester) {

                    existing.requesters.push(
                        requester
                    );

                }


                if (
                    existing.type ===
                    "points"
                ) {

                    if (
                        movie.type ===
                        "points"
                    ) {

                        existing.count++;

                    }

                }

                else if (
                    existing.type ===
                    "donation"
                ) {

                    if (
                        movie.type ===
                        "donation"
                    ) {

                        existing.amount +=
                            Number(
                                movie.amount
                            ) || 0;

                    }

                }

            }

        }
    );


    uniqueMovies =
        Array.from(
            movieMap.values()
        );


    segmentAngle =
        uniqueMovies.length
            ? 360 / uniqueMovies.length
            : 360;

}



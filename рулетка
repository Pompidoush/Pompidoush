.order-type-buttons {
    display: flex;
    gap: 7px;

    width: 100%;

    margin-bottom: 12px;
}

.order-type-button {
    flex: 1;

    min-height: 46px;

    padding: 8px 7px;

    border:
        1px solid
        rgba(140,190,215,0.28);

    border-radius: 7px;

    background:
        rgba(10,35,60,0.82);

    color:
        rgba(215,235,242,0.72);

    font-size: 12px;
    font-weight: 900;

    cursor: pointer;

    display: flex;

    align-items: center;
    justify-content: flex-start;

    gap: 7px;

    white-space: nowrap;
}

.order-type-button.selected {
    border-color:
        rgba(185,225,240,0.8);

    background:
        rgba(35,95,125,0.72);


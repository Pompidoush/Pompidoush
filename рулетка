        0 0 14px rgba(90,180,225,0.25);

    z-index: 50;
}


/* =========================================================
   РУЛЕТКА
   ========================================================= */

.wheel-container {
    position: absolute;

    left: 1500px;
    top: 575px;

    width: 760px;
    height: 760px;

    transform:
        translate(-50%, -50%);

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 20;
}

.wheel-container.party {
    animation:
        wheelParty
        0.8s
        ease-in-out
        infinite;
}

@keyframes wheelParty {
    0%,100% {
        transform:
            translate(-50%, -50%)
            scale(1);

        filter: brightness(1);
    }

    50% {
        transform:
            translate(-50%, -50%)
            scale(1.035);

        filter: brightness(1.32);
    }
}

.wheel-ring {
    position: absolute;

    width: 730px;
    height: 730px;

    border-radius: 50%;

    border:
        3px solid
        var(--silver);

    box-shadow:
        0 0 6px rgba(226,233,237,0.55),
        0 0 14px rgba(140,210,240,0.48),
        0 0 28px rgba(50,150,220,0.4),
        0 0 45px rgba(40,130,200,0.16);

    z-index: 30;
}

#wheel {
    position: relative;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    overflow: hidden;

    transform:
        rotate(0deg);

    transition:
        transform
        5s
        cubic-bezier(
            0.08,
            0.72,
            0.03,
            1
        );

    border:
        2px solid
        rgba(220,235,242,0.55);

    background:
        var(--night);

    box-shadow:
        0 0 14px rgba(22,100,160,0.48),
        0 0 30px rgba(7,26,56,0.65),
        0 0 48px rgba(40,140,210,0.16),
        inset 0 0 35px rgba(0,0,0,0.5);

    z-index: 25;
}

.wheel-background {
    position: absolute;
    inset: 0;

    border-radius: 50%;
    z-index: 1;
}

.wheel-background::after {
    content: "";

    position: absolute;
    inset: -10%;

    border-radius: 50%;

    background:
        repeating-radial-gradient(
            ellipse at center,
            transparent 0px,
            transparent 20px,
            rgba(255,255,255,0.035) 22px,
            transparent 27px
        );

    opacity: 0.7;

    transform:
        rotate(-15deg)
        scale(1.15);
}

.wheel-lines {
    position: absolute;
    inset: 0;

    border-radius: 50%;

    pointer-events: none;
    z-index: 5;
}

.wheel-line {
    position: absolute;

    width: 1px;
    height: 50%;

    left:
        calc(50% - 0.5px);

    top: 0;

    transform-origin:
        50% 100%;

    background:
        rgba(220,235,242,0.22);
}

.wheel-labels {
    position: absolute;
    inset: 0;

    border-radius: 50%;

    overflow: hidden;

    pointer-events: none;
    z-index: 10;
}

.label {
    position: absolute;

    width: 150px;
    height: 72px;

    left: 50%;
    top: 50%;

    margin-left: -75px;
    margin-top: -36px;

    display: flex;

    align-items: center;
    justify-content: center;

    color: var(--text);

    font-size: 17px;
    font-weight: 950;

    text-align: center;
    text-transform: uppercase;

    text-shadow:
        0 2px 5px rgba(0,0,0,0.95),
        0 0 6px rgba(0,0,0,0.9);

    transform:
        rotate(var(--angle))
        translateY(-255px)
        rotate(90deg);
}


/* =========================================================
   ЦЕНТР
   ========================================================= */

.center {
    position: absolute;

    width: 135px;
    height: 135px;

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%);

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            #164f82 0%,
            #0b2a59 55%,
            #071a38 100%
        );

    border:
        2px solid
        var(--silver);

    box-shadow:
        0 0 6px rgba(185,200,208,0.55),
        0 0 15px rgba(140,215,245,0.45),
        0 0 28px rgba(60,165,225,0.25),
        inset 0 0 22px rgba(0,0,0,0.55);

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 80;
}


/* =========================================================
   КНОПКА КРУТИТЬ
   ========================================================= */

.spin-button {
    position: absolute;

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%);

    padding: 0;
    margin: 0;

    border: none;
    outline: none;

    background: transparent;

    color: var(--silver-light);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 16px;
    font-weight: 950;

    letter-spacing: 3px;

    cursor: pointer;

    text-transform: uppercase;

    box-shadow: none;

    appearance: none;

    z-index: 100;

    pointer-events: auto;

    text-shadow:
        0 0 4px rgba(226,233,237,0.85),
        0 0 9px rgba(140,215,245,0.65),
        0 0 16px rgba(70,170,230,0.4);

    transition:
        transform 0.2s ease,
        text-shadow 0.2s ease,
        opacity 0.2s ease;
}

.spin-button:hover {
    transform:
        translate(-50%, -50%)
        scale(1.08);

    color: #ffffff;

    text-shadow:
        0 0 5px rgba(255,255,255,1),
        0 0 12px rgba(190,235,255,0.9),
        0 0 22px rgba(70,180,235,0.7);
}

.spin-button:active {
    transform:
        translate(-50%, -50%)
        scale(0.96);
}

.spin-button:disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
}

.pointer {
    position: absolute;

    top: 3px;
    left: 50%;

    transform:
        translateX(-50%);

    z-index: 50;

    width: 0;
    height: 0;

    border-left:
        16px solid transparent;

    border-right:
        16px solid transparent;

    border-top:
        38px solid
        var(--silver-light);

    filter:
        drop-shadow(
            0 0 5px
            rgba(150,220,245,0.7)
        )
        drop-shadow(
            0 0 12px
            rgba(60,160,220,0.45)
        );
}


/* =========================================================
   РЕЗУЛЬТАТ
   ========================================================= */

.result {
    position: absolute;

    left: 1500px;
    top: 1005px;

    transform:
        translateX(-50%);

    min-width: 620px;

    text-align: center;

    opacity: 0;

    z-index: 120;


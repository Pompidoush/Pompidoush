function chooseMovie() {

    const weights =
        uniqueMovies.map(
            movie => {

                if (
                    movie.type ===
                    "gold"
                ) {

                    return 10;

                }


                if (
                    movie.type ===
                    "donation"
                ) {

                    return Math.max(
                        1,
                        Number(
                            movie.amount
                        ) || 1
                    );

                }


                return Math.max(
                    1,
                    movie.count
                );

            }
        );


    const totalWeight =
        weights.reduce(
            (
                sum,
                weight
            ) =>
                sum + weight,
            0
        );


    let random =
        Math.random() *
        totalWeight;


    for (
        let i = 0;
        i < uniqueMovies.length;
        i++
    ) {

        random -=
            weights[i];


        if (
            random < 0
        ) {

            return i;

        }

    }


    return (
        uniqueMovies.length - 1
    );

}



    text-shadow:
        0 0 3px rgba(226,233,237,0.7),
        0 0 8px rgba(140,210,240,0.55),
        0 0 16px rgba(70,170,230,0.35);
}

.movie-list {
    height: calc(100% - 58px);

    display: flex;
    flex-direction: column;
    gap: 8px;

    overflow-y: auto;

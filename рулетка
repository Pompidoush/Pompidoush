/* =========================================================
   ТИП ЗАКАЗА
   ========================================================= */

.order-type-title {
    margin:
        8px 0 10px;

    font-size: 13px;
    font-weight: 900;

    letter-spacing: 1.5px;

    color:
        rgba(210,235,245,0.72);


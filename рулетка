<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, height=1080, initial-scale=1.0">
<title>Кинорулетка</title>

<style>

:root {
    --night: #071a38;
    --deep-blue: #0b2a59;
    --blue: #164f82;
    --silver: #b9c8d0;
    --silver-light: #e2e9ed;
    --silver-blue: #8fa4b0;
    --text: #e5ebee;
}

* {
    box-sizing: border-box;
}

html,
body {
    width: 1920px;
    height: 1080px;
    min-width: 1920px;
    min-height: 1080px;
    margin: 0;
    padding: 0;
    background: transparent;
    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;
}

.movie-wheel-wrapper {
    position: relative;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
}


/* =========================================================
   ПРАЗДНИК
   ========================================================= */

.celebration-flash {
    position: absolute;
    inset: 0;
    z-index: 500;
    pointer-events: none;
    opacity: 0;

    background:
        radial-gradient(
            circle at center,
            rgba(255,255,255,0.65) 0%,
            rgba(145,210,255,0.28) 25%,
            transparent 65%
        );
}

.celebration-flash.active {
    animation:
        flash
        0.28s
        ease-in-out
        infinite;
}

@keyframes flash {
    0% { opacity: 0; }
    50% { opacity: 0.72; }
    100% { opacity: 0; }
}

.celebration-border {
    position: absolute;
    inset: 0;
    z-index: 490;
    pointer-events: none;

    border: 12px solid transparent;
    opacity: 0;
}

.celebration-border.active {
    animation:
        borderFlash
        0.28s
        ease-in-out
        infinite;
}

@keyframes borderFlash {
    0% {
        opacity: 0;
        border-color: transparent;
        box-shadow: none;
    }

    50% {
        opacity: 1;
        border-color: rgba(230,245,255,0.95);

        box-shadow:
            inset 0 0 70px rgba(130,210,255,0.5),
            0 0 50px rgba(130,210,255,0.45);
    }

    100% {
        opacity: 0;
        border-color: transparent;
        box-shadow: none;
    }
}


/* =========================================================
   КОНФЕТТИ
   ========================================================= */

.confetti-container {
    position: absolute;
    inset: 0;
    z-index: 600;
    pointer-events: none;
    overflow: hidden;
}

.confetti {
    position: absolute;
    top: -90px;

    width: 12px;
    height: 22px;

    border-radius: 2px;
    opacity: 0;

    animation:
        confettiFall
        8s
        cubic-bezier(.12,.55,.28,1)
        forwards;
}

@keyframes confettiFall {
    0% {
        opacity: 0;

        transform:
            translate3d(0,-100px,0)
            rotate(0deg)
            scale(0.5);
    }

    4% { opacity: 1; }
    15% { opacity: 1; }
    75% { opacity: 0.95; }

    100% {
        opacity: 0;

        transform:
            translate3d(
                var(--drift),
                1350px,
                0
            )
            rotate(var(--rotation))
            scale(1);
    }
}


/* =========================================================
   ЗВЁЗДЫ
   ========================================================= */

.stars {
    position: absolute;
    inset: 0;

    width: 1920px;
    height: 1080px;

    pointer-events: none;
    overflow: hidden;
    z-index: 1;
}

.star {
    position: absolute;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: var(--silver-light);

    box-shadow:
        0 0 4px rgba(226,233,237,0.65),
        0 0 9px rgba(150,210,240,0.55),
        0 0 16px rgba(80,170,230,0.25);

    animation:
        twinkle
        var(--duration)
        ease-in-out
        infinite;

    opacity: 0.55;
}

.star.big {
    width: 7px;
    height: 7px;
}

@keyframes twinkle {
    0%,100% {
        transform: scale(0.65);
        opacity: 0.25;
    }

    50% {
        transform: scale(1.25);
        opacity: 0.75;
    }
}


/* =========================================================
   ЛЕВЫЙ ВИДЖЕТ
   ========================================================= */

.movie-list-panel {
    position: absolute;

    left: 450px;
    top: 50%;

    transform:
        translateY(calc(-50% - 15px));

    width: 500px;
    height: 850px;

    padding:
        28px
        30px
        30px;

    border:
        1px solid
        rgba(185,200,208,0.38);

    border-radius: 14px;

    background:
        rgba(5,18,40,0.48);

    box-shadow:
        0 0 10px rgba(130,205,240,0.12),
        0 0 25px rgba(22,100,160,0.16),
        0 0 45px rgba(60,150,210,0.06),

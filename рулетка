    const vanGoghColors = [

        "#09245A",
        "#0B3478",
        "#124B82",
        "#155A91",
        "#174B68",
        "#1E6380",
        "#0D315E",
        "#245B70",
        "#123D69",
        "#28677A",
        "#0A2852",
        "#1B5270",
        "#17466A",
        "#2A6A78",
        "#103A64"

    ];


    const shuffledColors =
        [...vanGoghColors].sort(
            () =>
                Math.random() - 0.5
        );


    const sectorColors =
        shuffledColors.slice(
            0,
            uniqueMovies.length
        );


    const sectorGradient =
        sectorColors
            .map(
                (color, index) => {

                    const start =
                        index *
                        segmentAngle;

                    const end =
                        (index + 1) *
                        segmentAngle;

                    return `
                        ${color}
                        ${start}deg
                        ${end}deg
                    `;

